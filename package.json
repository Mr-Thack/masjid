{
  "name": "masjid",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "dev": "npm run dev -w @masjid/api",
    "dev:tv": "npm run dev -w @masjid/tv",
    "dev:consumer": "npm run dev -w @masjid/consumer",
    "dev:admin": "npm run dev --workspace=@masjid/admin",
    "dev:all": "npm run dev -w @masjid/api & npm run dev -w @masjid/tv & npm run dev -w @masjid/consumer & npm run dev -w @masjid/admin",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "check": "npm run check --workspaces --if-present",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run check-schema && vitest run && vitest run --config vitest.tv.config.ts && vitest run --config vitest.consumer.config.ts && vitest run --config vitest.whatsapp.config.ts && vitest run --config vitest.agent.config.ts && vitest run --config vitest.tooling.config.ts && vitest run --config vitest.integration.config.ts",
    "test:tv": "vitest run --config vitest.tv.config.ts",
    "test:consumer": "vitest run --config vitest.consumer.config.ts",
    "test:sw": "node apps/consumer/tests/sw-integration.test.js",
    "test:e2e": "node tests/e2e/run.js",
    "test:e2e:staging": "E2E_ENV=staging node tests/e2e/run.js",
    "test:e2e:prod": "E2E_ENV=prod node tests/e2e/run.js",
    "test:whatsapp": "vitest run --config vitest.whatsapp.config.ts",
    "test:agent": "vitest run --config vitest.agent.config.ts",
    "test:admin": "vitest run --config vitest.admin.config.ts",
    "test:tooling": "vitest run --config vitest.tooling.config.ts",
    "check-schema": "npx tsx tooling/check-schema-drift.ts",
    "test:watch": "vitest",
    "db:generate": "npm run db:generate -w @masjid/api",
    "db:migrate": "npm run db:migrate -w @masjid/api",
    "db:seed": "npx tsx tooling/seed.ts",
    "setup": "node tooling/setup.js",
    "typecheck": "npm run check --workspaces --if-present",
    "deploy:workers": "node tooling/deploy-workers.js",
    "deploy:pages": "node tooling/deploy-pages.js",
    "deploy:all": "node tooling/deploy-all.js"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^3.1.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.24.2": true,
    "esbuild@0.19.12": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "esbuild@0.17.19": true,
    "sharp@0.33.5": true,
    "workerd@1.20250718.0": true,
    "better-sqlite3@12.11.1": true
  },
  "dependencies": {
    "opencode-agent-browser": "^1.0.0"
  }
}
